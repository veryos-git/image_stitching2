#!/usr/bin/env python3
"""Start every Stitch Lab web tool with one command: ./start"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
from urllib.request import build_opener, ProxyHandler

ROOT = Path(__file__).resolve().parent
REQUIREMENTS = (
    'requirements.txt', 'requirements-comparison.txt',
    'requirements-microscope.txt', 'requirements-guided.txt',
    'requirements-matchanything.txt',
)
SETUP_SCRIPTS = ('download_weights.py', 'setup_xfeat.py', 'setup_efficientloftr.py', 'setup_matchanything.py')


def run(*command):
    subprocess.run([str(part) for part in command], cwd=ROOT, check=True)


def prepare_environment():
    """Bootstrap locally and only cache a fully successful installation."""
    python = ROOT / '.venv/bin/python'
    stamp = ROOT / '.venv/.stitch-lab-setup'
    digest = hashlib.sha256()
    for name in ('start', *REQUIREMENTS, *SETUP_SCRIPTS):
        digest.update((ROOT / name).read_bytes())
    fingerprint = digest.hexdigest()
    assets = (
        'vendor/accelerated_features/modules/xfeat.py',
        'vendor/EfficientLoFTR/src/loftr/loftr.py',
        'vendor/MatchAnything/src/loftr/loftr.py',
        'weights/superpoint_v1.pth', 'weights/superglue_indoor.pth',
        'weights/superglue_outdoor.pth', 'weights/eloftr_outdoor.ckpt',
        'weights/matchanything_eloftr.ckpt',
    )
    if (python.is_file() and stamp.is_file()
            and stamp.read_text() == fingerprint
            and all((ROOT / name).is_file() for name in assets)):
        return python

    if not shutil.which('git'):
        sys.exit('Setup requires Git. Install git using your system package manager, then rerun ./start.')
    print('Preparing Stitch Lab (first setup downloads packages and model weights)...', flush=True)
    stamp.unlink(missing_ok=True)
    if not python.is_file():
        try:
            run(sys.executable, '-m', 'venv', ROOT / '.venv')
        except subprocess.CalledProcessError:
            sys.exit('Could not create .venv. Install Python venv support '
                     '(python3-venv on Debian/Ubuntu), then rerun ./start.')
    run(python, '-m', 'ensurepip', '--upgrade')
    run(python, '-m', 'pip', 'install', '--upgrade', 'pip')
    command = [python, '-m', 'pip', 'install']
    for name in REQUIREMENTS:
        command.extend(('-r', ROOT / name))
    run(*command)
    for script in SETUP_SCRIPTS:
        run(python, ROOT / script)
    run(python, '-m', 'pip', 'check')
    run(python, '-c', 'import server')
    if not all((ROOT / name).is_file() for name in assets):
        sys.exit('Setup is missing model files. Check vendor/ and weights/, then rerun ./start.')
    stamp.write_text(fingerprint)
    return python


def banner(host, port, existing=False):
    browser_host = '127.0.0.1' if host in ('0.0.0.0', '::') else host
    if ':' in browser_host:
        browser_host = f'[{browser_host}]'
    base = f'http://{browser_host}:{port}'
    print('\n  Stitch Lab' + (' — already running' if existing else ''), flush=True)
    print(f'\n  Overview:             {base}/overview\n'
          f'  Pipeline comparison:  {base}/compare\n'
          f'  Microscope mosaic:    {base}/microscope\n'
          f'  Classic stitcher:     {base}/classic\n'
          f'  Grow a mosaic:        {base}/guided\n', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=8001)
    parser.add_argument('--host', default='127.0.0.1')
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error('port must be between 1 and 65535')
    probe_host = '127.0.0.1' if args.host == '0.0.0.0' else ('::1' if args.host == '::' else args.host)
    opener = build_opener(ProxyHandler({}))
    free_port = None
    for port in range(args.port, min(args.port + 20, 65536)):
        url_host = f'[{probe_host}]' if ':' in probe_host else probe_host
        try:
            with opener.open(f'http://{url_host}:{port}/api/health', timeout=.4) as response:
                health = json.load(response)
            if health.get('app') == 'stitch-lab' and health.get('overview') in ('/', '/overview'):
                banner(args.host, port, existing=True)
                return
        except (OSError, ValueError):
            pass
        try:
            with socket.socket(socket.AF_INET6 if ':' in args.host else socket.AF_INET) as sock:
                sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                sock.bind((args.host, port))
        except OSError:
            continue
        if free_port is None:
            free_port = port
    if free_port is not None:
        try:
            python = prepare_environment()
        except subprocess.CalledProcessError as exc:
            sys.exit(f'Setup failed (exit {exc.returncode}). Fix the error above and rerun ./start.')
        except KeyboardInterrupt:
            sys.exit('Setup interrupted. Rerun ./start to retry.')
        os.chdir(ROOT)
        os.execv(str(python), [str(python), '-u', str(ROOT / 'server.py'), '--host', args.host, '--port', str(free_port)])
    sys.exit('No free port found in the next 20 ports. Try ./start --port 9000')


if __name__ == '__main__':
    main()
