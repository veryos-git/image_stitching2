#!/usr/bin/env python3
"""Start every Stitch Lab web tool with one command: ./start"""
import argparse
import json
import os
from pathlib import Path
import socket
import sys
from urllib.request import build_opener, ProxyHandler

ROOT = Path(__file__).resolve().parent


def banner(host, port, existing=False):
    browser_host = '127.0.0.1' if host in ('0.0.0.0', '::') else host
    if ':' in browser_host:
        browser_host = f'[{browser_host}]'
    base = f'http://{browser_host}:{port}'
    print('\n  Stitch Lab' + (' — already running' if existing else ''), flush=True)
    print(f'\n  Overview:             {base}/\n'
          f'  Pipeline comparison:  {base}/compare\n'
          f'  Microscope mosaic:    {base}/microscope\n'
          f'  Classic stitcher:     {base}/classic\n'
          f'  Grow a mosaic:        {base}/guided\n', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=8001)
    parser.add_argument('--host', default='127.0.0.1')
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error('port must be between 1 and 65535')
    python = ROOT / '.venv/bin/python'
    if not python.is_file():
        sys.exit('Missing .venv. Follow the installation instructions in README.md first.')
    probe_host = '127.0.0.1' if args.host == '0.0.0.0' else ('::1' if args.host == '::' else args.host)
    opener = build_opener(ProxyHandler({}))
    free_port = None
    for port in range(args.port, min(args.port + 20, 65536)):
        url_host = f'[{probe_host}]' if ':' in probe_host else probe_host
        try:
            with opener.open(f'http://{url_host}:{port}/api/health', timeout=.4) as response:
                health = json.load(response)
            if health.get('app') == 'stitch-lab' and health.get('overview') == '/':
                banner(args.host, port, existing=True)
                return
        except (OSError, ValueError):
            pass
        try:
            with socket.socket(socket.AF_INET6 if ':' in args.host else socket.AF_INET) as sock:
                sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                sock.bind((args.host, port))
        except OSError:
            continue
        if free_port is None:
            free_port = port
    if free_port is not None:
        os.chdir(ROOT)
        os.execv(str(python), [str(python), '-u', str(ROOT / 'server.py'), '--host', args.host, '--port', str(free_port)])
    sys.exit('No free port found in the next 20 ports. Try ./start --port 9000')


if __name__ == '__main__':
    main()
